startPort: 9400
macros:
  emb_hf_model: Qwen/Qwen3-Embedding-8B-GGUF:Q5_K_M
  draft_context: '256'
models:
  qwen3-chat:
    concurrencyLimit: 4
    name: Pi Qwen3 Chat 27B Spiritbuun
    description: Primary chat/completions model using spiritbuun dflash with a published
      GGUF draft
    filters:
      setParams:
        reasoning: 'off'
        chat_template_kwargs:
          tokenize: false
          add_generation_prompt: true
          enable_thinking: false
          preserve_thinking: false
    cmd: '${server_bin}
      server
      spiritbuun
      --bin /app/bin/llama-server-spiritbuun
      --port ${PORT}
      --target-hf unsloth/Qwen3.6-27B-GGUF:Q5_K_M
      --draft-hf Ardenzard/Qwen3.6-27B-DFlash-GGUF:Qwen3.6-27B-DFlash-Q5_K_M.gguf
      --ctx-size 262144
      --keep -1
      --n-predict -1
      --temp 0.7
      --batch-size 256
      --ubatch-size 64
      --parallel 1
      --flash-attn on
      --cache-type-k turbo4
      --cache-type-v turbo4
      --cache-type-k-draft f16
      --cache-type-v-draft f16
      --cache-ram 0
      --gpu-layers-draft all
      --no-webui
      --no-warmup
      --no-mmap
      --context-shift
      --chat-template-kwargs {\"tokenize\":false,\"add_generation_prompt\":true,\"enable_thinking\":false,\"preserve_thinking\":false}
      --reasoning off
      -cd ${draft_context}
      --draft-max 8
      --draft-min 1
      --draft-p-min 0.75
      '
  qwen3-embeddings:
    concurrencyLimit: 4
    name: Pi Qwen3 Embeddings 8B
    description: Dense embedding model for vector search, RAG, similarity
    cmd: '${server_bin}
      server
      llamacpp
      --bin /app/bin/llama-server-spiritbuun
      --port ${PORT}
      -hf ${emb_hf_model}
      --ctx-size 262144
      --batch-size 1024
      --ubatch-size 256
      --parallel 1
      --flash-attn on
      --cache-type-k f16
      --cache-type-v f16
      --kv-unified
      --no-mmap
      --embedding
      --no-warmup
      '
