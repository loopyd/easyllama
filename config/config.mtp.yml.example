# yaml-language-server: $schema=https://raw.githubusercontent.com/mostlygeek/llama-swap/refs/heads/main/config-schema.json
#
# Local runtime configuration template for MTP mode.
# Copy this file to config/config.mtp.yml for local edits and overrides.
# Qwen3.8 NVFP4 chat uses vLLM MTP; auxiliary GGUF routes remain on llama.cpp.

healthCheckTimeout: 1800
logLevel: info
sendLoadingState: false
globalTTL: 0

hooks:
  on_startup:
    preload:
      - "qwen3-chat"

macros:
  server_bin: "/usr/local/bin/easyllama"
  vllm_wrapper_bin: "/app/bin/vllm-wrapper"
  vllm_bin: "/opt/venv/bin/vllm"
  qwen3_chat_target_hf: "unsloth/Qwen3.8-27B-NVFP4"
  pi_emb_hf_model: "Qwen/Qwen3-Embedding-8B-GGUF:Q5_K_M"
models:
  "qwen3-chat":
    concurrencyLimit: 1
    name: "Qwen3.8 Chat 27B NVFP4 MTP"
    description: "Primary chat/completions model served by vLLM with MTP speculative decoding"
    cmd: |
      ${vllm_wrapper_bin}
      serve
      --vllm-url http://127.0.0.1:18000
      --listen :${PORT}
      --sleep-level 1
      --wait-timeout 1800s
      --
      /app/bin/log-exec
      ${vllm_bin}
      serve
      ${qwen3_chat_target_hf}
      --host 127.0.0.1
      --port 18000
      --served-model-name qwen3-chat
      --max-model-len 131072
      --max-num-seqs 1
      --max-num-batched-tokens 4096
      --kv-cache-dtype fp8
      --gpu-memory-utilization 0.90
      --no-enable-flashinfer-autotune
      --enforce-eager
      --language-model-only
      --uvicorn-log-level info
      --enable-log-requests
      --log-error-stack
      --reasoning-parser qwen3
      --enable-auto-tool-choice
      --tool-call-parser qwen3_coder
      --enable-sleep-mode
      --speculative-config '{"method":"mtp","num_speculative_tokens":1}'
      --enable-chunked-prefill
    cmdStop: |
      ${vllm_wrapper_bin}
      sleep
      --vllm-url http://127.0.0.1:18000
      --sleep-level 2
      --stop-pid ${PID}
    env:
      - "HF_TOKEN=${env.HF_TOKEN}"
      - "VLLM_SERVER_DEV_MODE=1"
      - "VLLM_LOGGING_LEVEL=INFO"
      - "PYTHONFAULTHANDLER=1"

  "qwen3-embeddings":
    concurrencyLimit: 4
    name: "Qwen3 Embeddings 8B"
    description: "Dense embedding model for vector search, RAG, similarity"
    cmd: |
      ${server_bin}
      server
      basic
      --bin /app/bin/llama-server-mtp
      --port ${PORT}
      -hf ${pi_emb_hf_model}
      --ctx-size 131072
      --batch-size 2048
      --ubatch-size 1024
      --parallel 1
      --flash-attn on
      --cache-type-k f16
      --cache-type-v f16
      --no-mmap
      --embedding
      --no-warmup
    cmdStop: /bin/kill -TERM ${PID}
    env:
      - "HF_TOKEN=${env.HF_TOKEN}"
