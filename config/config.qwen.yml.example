globalTTL: 1800
routing:
  router:
    use: group
    settings:
      groups:
        gpu:
          swap: true
          exclusive: true
          members:
          - qwen3-chat
        search:
          swap: false
          exclusive: true
          members:
          - qwen3-embeddings
          - qwen3-reranker
macros:
  qwen3_chat_target_hf: 0bserverx/Qwen3.8-27B-Heretic-Abliterated-Uncensored-GGUF:RVN-Q4_K_M-multilingual-mtp.gguf
  pi_emb_hf_model: Qwen/Qwen3-Embedding-0.6B-GGUF:Qwen3-Embedding-0.6B-f16.gguf
  qwen3_reranker_hf: gpustack/bge-reranker-v2-m3-GGUF:bge-reranker-v2-m3-Q8_0.gguf
models:
  qwen3-chat:
    concurrencyLimit: 0
    name: Qwen3.8 Chat 27B RVN Heretic Q4_K_M MTP
    description: Primary thinking/tool-use model; multilingual RVN Heretic Q4_K_M with embedded MTP served by llama.cpp
    cmd: '${server_bin}
      server
      qwen
      --bin /app/bin/llama-server-qwen
      --host 0.0.0.0
      --port ${PORT}
      -hf ${qwen3_chat_target_hf}
      --no-mmproj
      --ctx-size 262144
      --n-predict 32768
      --n-gpu-layers all
      --fit off
      --parallel 4
      --threads 8
      --threads-batch 8
      --kv-unified
      --spec-type draft-mtp
      --spec-draft-n-max 2
      --spec-draft-n-min 0
      --spec-draft-type-k q8_0
      --spec-draft-type-v q8_0
      --flash-attn on
      --cache-type-k q8_0
      --cache-type-v q8_0
      --batch-size 4096
      --ubatch-size 1024
      --cache-prompt
      --cache-ram 4096
      --ctx-checkpoints 8
      --load-mode mmap
      --no-warmup
      --no-webui
      --jinja
      --chat-template-file /chat_template/qwen3.8.jinja
      --reasoning auto
      --reasoning-preserve
      --temp 1.0
      --top-p 0.95
      --top-k 20
      --min-p 0.0
      --repeat-penalty 1.0
      '
    cmdStop: /bin/kill -TERM ${PID}
  qwen3-embeddings:
    ttl: 0
    concurrencyLimit: 0
    name: Qwen3 Embeddings 0.6B FP16
    description: Dense embedding model for vector search, RAG, similarity
    cmd: '${server_bin}
      server
      qwen
      --bin /app/bin/llama-server-qwen
      --host 0.0.0.0
      --port ${PORT}
      -hf ${pi_emb_hf_model}
      --n-gpu-layers all
      --device CUDA0
      --fit off
      --threads 4
      --threads-batch 4
      --ctx-size 131072
      --batch-size 512
      --ubatch-size 512
      --parallel 4
      --flash-attn on
      --cache-type-k f16
      --cache-type-v f16
      --no-mmap
      --embedding
      --pooling last
      --no-warmup
      '
    cmdStop: /bin/kill -TERM ${PID}
  qwen3-reranker:
    ttl: 0
    concurrencyLimit: 0
    name: BGE Reranker v2 M3 Q8_0
    description: Compact GPU cross-encoder for query-document relevance, co-resident with embeddings
    cmd: '${server_bin}
      server
      qwen
      --bin /app/bin/llama-server-qwen
      --host 0.0.0.0
      --port ${PORT}
      -hf ${qwen3_reranker_hf}
      --n-gpu-layers all
      --device CUDA0
      --fit off
      --threads 2
      --threads-batch 2
      --ctx-size 16384
      --batch-size 8192
      --ubatch-size 8192
      --parallel 2
      --embedding
      --pooling rank
      --reranking
      --no-warmup
      --no-webui
      '
    cmdStop: /bin/kill -TERM ${PID}
