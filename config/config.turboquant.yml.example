# yaml-language-server: $schema=https://raw.githubusercontent.com/mostlygeek/llama-swap/refs/heads/main/config-schema.json
#
# Copy this tracked template to config/config.turboquant.yml for local overrides.
# Turboquant uses a llama.cpp fork with quantized KV-cache types.

healthCheckTimeout: 1800
logLevel: info
sendLoadingState: false
globalTTL: 0

# Shared llama-server arguments.
macros:
  server_bin: "/opt/venv/bin/easyllama"
  qwen3_chat_target_hf: "unsloth/Qwen3.6-27B-GGUF:UD-Q5_K_XL"
  pi_emb_hf_model: "Qwen/Qwen3-Embedding-8B-GGUF:Q5_K_M"

models:
  "qwen3-chat":
    concurrencyLimit: 4
    name: "Pi Qwen3 Chat 27B Turboquant"
    description: "Primary chat/completions model with turboquant KV cache enabled"
    filters:
      setParams:
        reasoning: "off"
        chat_template_kwargs:
          tokenize: false
          add_generation_prompt: true
          enable_thinking: false
          preserve_thinking: false
    cmd: |
      ${server_bin}
      server
      basic
      --bin /app/bin/llama-server-turboquant
      --port ${PORT}
      -hf ${qwen3_chat_target_hf}
      --ctx-size 131072
      --n-predict -1
      --temp 0.65
      --top-k 20
      --top-p 0.95
      --min-p 0.0
      --sampler-seq edskypmxt
      --repeat-last-n 2048
      --repeat-penalty 1.01
      --presence-penalty 1.0
      --frequency-penalty 0.0
      --dry-multiplier 0.0
      --dry-base 1.75
      --dry-allowed-length 2
      --dry-penalty-last-n 2048
      --batch-size 2048
      --ubatch-size 512
      --parallel 1
      --fit on
      --flash-attn on
      --cache-type-k turbo4
      --cache-type-v turbo3
      --kv-unified
      --cache-idle-slots
      --backend-sampling
      --no-webui
      --no-mmap
      --poll 1
      --chat-template-kwargs {\"tokenize\":false,\"add_generation_prompt\":true,\"enable_thinking\":false,\"preserve_thinking\":false}
      --reasoning off

    env:
      - "HF_TOKEN=${env.HF_TOKEN}"

  "qwen3-embeddings":
    concurrencyLimit: 4
    name: "Pi Qwen3 Embeddings 8B"
    description: "Dense embedding model for vector search, RAG, similarity"
    cmd: |
      ${server_bin}
      server
      basic
      --bin /app/bin/llama-server-turboquant
      --port ${PORT}
      -hf ${pi_emb_hf_model}
      --ctx-size 131072
      --batch-size 2048
      --ubatch-size 512
      --parallel 1
      --flash-attn on
      --cache-type-k f16
      --cache-type-v f16
      --kv-unified
      --no-mmap
      --embedding
      --no-warmup

    env:
      - "HF_TOKEN=${env.HF_TOKEN}"
