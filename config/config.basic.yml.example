# yaml-language-server: $schema=https://raw.githubusercontent.com/mostlygeek/llama-swap/refs/heads/main/config-schema.json
#
# Copy this file to config/config.basic.yml for local edits and overrides.
# Use this default mode with ./run.sh start when you want the original plain
# llama-server qwen3-chat path without Luce dflash+pflash.
#
# Exposes:
# - qwen3-chat for chat/completions-style requests without dflash+pflash
# - qwen3-embeddings for /v1/embeddings
#
# Common local flow:
# - cp config/config.basic.yml.example config/config.basic.yml
# - ./run.sh start
# - curl http://localhost:8080/v1/models
# - model downloads begin on first authenticated use, not during container startup
#
# Primary API routes:
# - POST /v1/chat/completions with model=qwen3-chat
# - POST /v1/embeddings with model=qwen3-embeddings

healthCheckTimeout: 1800
logLevel: info
sendLoadingState: false
globalTTL: 0

# Shared llama-server argument macros
macros:
  server_bin: "/opt/venv/bin/easyllama"
  qwen3_chat_target_hf: "unsloth/Qwen3.6-27B-GGUF:Q4_K_M"
  pi_emb_hf_model: "Qwen/Qwen3-Embedding-8B-GGUF:Q5_K_M"
  mmproj_arg: "${env.EASYLLAMA_MMPROJ_ARG}"

models:
  # Chat model
  # Plain llama-server qwen3-chat path without Luce dflash+pflash.
  "qwen3-chat":
    concurrencyLimit: 4
    name: "Pi Qwen3 Chat"
    description: "Primary llama-server chat/completions model without dflash+pflash"
    filters:
      setParams:
        reasoning: "off"
        chat_template_kwargs:
          tokenize: false
          add_generation_prompt: true
          enable_thinking: false
          preserve_thinking: false
    cmd: |
      ${server_bin}
      server
      basic
      --bin /app/bin/llama-server-basic
      --port ${PORT}
      -hf ${qwen3_chat_target_hf}
      ${mmproj_arg}
      --ctx-size 131072
      --n-predict 8192
      --temp 0.6
      --top-k 20
      --top-p 0.95
      --min-p 0.0
      --sampler-seq edskypmxt
      --repeat-last-n 512
      --repeat-penalty 1.05
      --presence-penalty 1.5
      --frequency-penalty 0.0
      --dry-multiplier 0.0
      --dry-base 1.75
      --dry-allowed-length 2
      --dry-penalty-last-n 2048
      --batch-size 1024
      --ubatch-size 256
      --parallel 1
      --fit on
      --flash-attn on
      --cache-type-k q4_0
      --cache-type-v q8_0
      --kv-unified

      --backend-sampling
      --no-webui
      --no-warmup
      --no-mmap
      --poll 1
      --jinja
      --chat-template-file /chat_template/qwen3.6.jinja
      --chat-template-kwargs {\"tokenize\":false,\"add_generation_prompt\":true,\"enable_thinking\":false,\"preserve_thinking\":false}
      --reasoning off

    env:
      - "HF_TOKEN=${env.HF_TOKEN}"

  # Embedding model
  # Lightweight config for /v1/embeddings requests.
  "qwen3-embeddings":
    concurrencyLimit: 4
    name: "Pi Qwen3 Embeddings 8B"
    description: "Dense embedding model for vector search, RAG, similarity"
    cmd: |
      ${server_bin}
      server
      basic
      --bin /app/bin/llama-server-basic
      --port ${PORT}
      -hf ${pi_emb_hf_model}
      --ctx-size 131072
      --batch-size 1024
      --ubatch-size 256
      --parallel 1
      --flash-attn on
      --cache-type-k f16
      --cache-type-v f16
      --kv-unified
      --no-mmap
      --embedding
      --no-warmup

    env:
      - "HF_TOKEN=${env.HF_TOKEN}"

  # Uses the existing chat model without changing Pi's current alias.
