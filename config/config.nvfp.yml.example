# yaml-language-server: $schema=https://raw.githubusercontent.com/mostlygeek/llama-swap/refs/heads/main/config-schema.json
#
# RTX 5090 / Blackwell Qwen3.6-35B-A3B runtime configuration template.
# Copy this file to config/config.mtp.yml for local edits and overrides.
# NVFP4 expert weights and q4_0 KV cache are the fastest validated single-stream llama.cpp path.
# MTP is deliberately disabled: its draft/verify overhead is currently slower for this MoE.

healthCheckTimeout: 1800
logLevel: info
sendLoadingState: false
# Keep chat and embeddings resident; query expansion and reranking swap in alone.
# `matrix` does not preload workers—run `./run.sh --mode nvfp warmup` after start/restart.
globalTTL: 0
matrix:
  vars:
    chat: qwen3-chat
    emb: qwen3-embeddings
  sets:
    resident: "chat & emb"

macros:
  server_bin: "/opt/venv/bin/easyllama"
  chat_threads: "8"
  chat_threads_batch: "16"
  chat_gpu_layers: "999"
  llama_server_bin: "/app/bin/llama-server-nvfp"
  chat_ctx_size: "262144"
  qmd_ctx_size: "131072"
  qwen3_chat_target_hf: "LibertAIDAI/Qwen3.6-35B-A3B-NVFP4-GGUF:Qwen3.6-35B-A3B-NVFP4-Q4_K_M.gguf"
  pi_emb_hf_model: "Qwen/Qwen3-Embedding-4B-GGUF:Q4_K_M"
  qmd_chat_hf_model: "tobil/qmd-query-expansion-1.7B-gguf:Q8_0"
  qmd_emb_hf_model: "Qwen/Qwen3-Embedding-4B-GGUF:Q4_K_M"
  qmd_rerank_hf_model: "Voodisss/Qwen3-Reranker-4B-GGUF-llama_cpp:Qwen3-Reranker-4B-Q4_K_M.gguf"
  n_predict: "-1"
  temp: "0.7"
  top_k: "20"
  top_p: "0.80"
  min_p: "0.0"
  sampler_seq: "edskypmxt"
  repeat_last_n: "512"
  repeat_penalty: "1.0"
  presence_penalty: "1.5"
  frequency_penalty: "0.0"
  dry_multiplier: "0.0"
  dry_base: "1.75"
  dry_allowed_length: "2"
  dry_penalty_last_n: "512"
  batch_size: "1024"
  ubatch_size: "256"
  parallel: "1"
  flash_attn: "on"
  fit: "off"
  cache_type_k: "q4_0"
  cache_type_v: "q4_0"
  poll: "0"
  poll_batch: "0"
  no_mmap: "--no-mmap"
  web_ui_off: "--no-webui"
  no_warmup: "--no-warmup"
  jinja_on: "--jinja"
  chat_template_file: "/chat_template/qwen3.6.jinja"
  chat_template_kwargs: '{\"tokenize\":false,\"add_generation_prompt\":true,\"enable_thinking\":false,\"preserve_thinking\":false}'
  emb_cache_type_k: "f16"
  emb_cache_type_v: "f16"
  rerank_batch_size: "2048"
  rerank_ubatch_size: "2048"
  rerank_ctx_size: "4096"

models:
  "qwen3-chat":
    name: "Pi Qwen3.6 Chat 35B-A3B NVFP4"
    description: "RTX 5090 Blackwell NVFP4 MoE chat/completions model; MTP disabled for peak single-stream throughput"
    cmd: |
      ${server_bin}
      server
      basic
      --bin ${llama_server_bin}
      --port ${PORT}
      --threads ${chat_threads}
      --threads-batch ${chat_threads_batch}
      -hf ${qwen3_chat_target_hf}
      --ctx-size ${chat_ctx_size}
      --n-predict ${n_predict}
      --temp ${temp}
      --top-k ${top_k}
      --top-p ${top_p}
      --min-p ${min_p}
      --sampler-seq ${sampler_seq}
      --repeat-last-n ${repeat_last_n}
      --repeat-penalty ${repeat_penalty}
      --presence-penalty ${presence_penalty}
      --frequency-penalty ${frequency_penalty}
      --dry-multiplier ${dry_multiplier}
      --dry-base ${dry_base}
      --dry-allowed-length ${dry_allowed_length}
      --dry-penalty-last-n ${dry_penalty_last_n}
      --batch-size ${batch_size}
      --ubatch-size ${ubatch_size}
      --parallel ${parallel}
      --fit ${fit}
      --gpu-layers ${chat_gpu_layers}
      --flash-attn ${flash_attn}
      --cache-type-k ${cache_type_k}
      --cache-type-v ${cache_type_v}
      ${web_ui_off}
      ${no_mmap}
      --poll ${poll}
      --poll-batch ${poll_batch}
      --chat-template-kwargs ${chat_template_kwargs}
    env:
      - "HF_TOKEN=${env.HF_TOKEN}"

  "qwen3-embeddings":
    name: "Pi Qwen3 Embeddings 4B"
    description: "Qwen3 4B dense embeddings: the NVFP balanced speed/quality profile; rebuild existing 8B vector indexes before use"
    aliases:
      - "qmd-embed"
    cmd: |
      ${server_bin}
      server
      basic
      --bin ${llama_server_bin}
      --port ${PORT}
      -hf ${pi_emb_hf_model}
      --ctx-size ${qmd_ctx_size}
      --batch-size ${batch_size}
      --ubatch-size ${ubatch_size}
      --parallel ${parallel}
      --flash-attn ${flash_attn}
      --cache-type-k ${emb_cache_type_k}
      --cache-type-v ${emb_cache_type_v}
      ${no_mmap}
      --embedding
      ${no_warmup}
    env:
      - "HF_TOKEN=${env.HF_TOKEN}"

  "qmd-generate":
    name: "QMD Query Expansion"
    description: "Alias for QMD query expansion and OpenAI-compatible completions"
    filters:
      setParams:
        reasoning: "off"
        chat_template_kwargs:
          tokenize: false
          add_generation_prompt: true
          enable_thinking: false
          preserve_thinking: false
    cmd: |
      ${server_bin}
      server
      basic
      --bin ${llama_server_bin}
      --port ${PORT}
      -hf ${qmd_chat_hf_model}
      --ctx-size ${qmd_ctx_size}
      --n-predict ${n_predict}
      --temp ${temp}
      --top-k ${top_k}
      --top-p ${top_p}
      --min-p ${min_p}
      --sampler-seq ${sampler_seq}
      --repeat-last-n ${repeat_last_n}
      --repeat-penalty ${repeat_penalty}
      --presence-penalty ${presence_penalty}
      --frequency-penalty ${frequency_penalty}
      --dry-multiplier ${dry_multiplier}
      --dry-base ${dry_base}
      --dry-allowed-length ${dry_allowed_length}
      --dry-penalty-last-n ${dry_penalty_last_n}
      --batch-size ${batch_size}
      --ubatch-size ${ubatch_size}
      --parallel ${parallel}
      --fit ${fit}
      --flash-attn ${flash_attn}
      --cache-type-k ${cache_type_k}
      --cache-type-v ${cache_type_v}
      ${web_ui_off}
      ${no_warmup}
      ${no_mmap}
      --poll ${poll}
      ${jinja_on}
      --chat-template-file ${chat_template_file}
      --chat-template-kwargs ${chat_template_kwargs}
      --reasoning off
    env:
      - "HF_TOKEN=${env.HF_TOKEN}"

  "qmd-rerank":
    name: "Qwen3 Reranker 4B"
    description: "Qwen3 4B cross-encoder reranking: NVFP balanced speed/quality profile"
    cmd: |
      ${server_bin}
      server
      basic
      --bin ${llama_server_bin}
      --port ${PORT}
      -hf ${qmd_rerank_hf_model}
      --ctx-size ${rerank_ctx_size}
      --batch-size ${rerank_batch_size}
      --ubatch-size ${rerank_ubatch_size}
      --parallel ${parallel}
      --flash-attn ${flash_attn}
      --cache-type-k ${emb_cache_type_k}
      --cache-type-v ${emb_cache_type_v}
      ${no_mmap}
      --reranking
      ${no_warmup}
    env:
      - "HF_TOKEN=${env.HF_TOKEN}"
