# Experimental PTQ1_0 + ProCreations Q8_0 DFlash2 profile.
# Use the pinned Prism build from config.json.example.
# Select with EASYLLAMA_LS_CONFIG_FILE; use config.bonsai-plain.yml.example for plain PQ2_0.
# Change bonsai_spec_type to ngram-mod,draft-dflash for code-edit loops.
# All three routes stay in the same non-swapping GPU group.
# Three slots preserve GPU headroom with the drafter and both search models.
# Six slots passed smoke tests but left only 171 MiB free on the RTX 5090.
# Three slots passed the same mixed traffic checks with about 4.2 GiB free.
# Validate full-context fit and concurrent traffic before promoting.
startPort: 9600
healthCheckTimeout: 300
globalTTL: 1800
routing:
  router:
    use: group
    settings:
      groups:
        gpu:
          swap: false
          exclusive: false
          members:
          - bonsai-chat
          - qwen3-embeddings
          - qwen3-reranker
macros:
  bonsai_target: /root/.cache/huggingface/hub/models--prism-ml--Ternary-Bonsai-2-27B-gguf/snapshots/b072e1d3b35a0a630cece372c2127528e0994386/Ternary-Bonsai-2-27B-PTQ1_0.gguf
  bonsai_drafter: /root/.cache/huggingface/hub/models--ProCreations--Ternary-Bonsai-2-27B-DFlash2/snapshots/4cfb6ad03268fed0f60ca96c1a659c0b1c77e50b/Bonsai-2-27B-DFlash2-Q8_0.gguf
  bonsai_spec_type: draft-dflash
  embedding_model: /root/.cache/huggingface/hub/models--Qwen--Qwen3-Embedding-0.6B-GGUF/snapshots/370f27d7550e0def9b39c1f16d3fbaa13aa67728/Qwen3-Embedding-0.6B-f16.gguf
  reranker_model: /root/.cache/huggingface/hub/models--gpustack--bge-reranker-v2-m3-GGUF/snapshots/3093af03b1a635e67b084b1d8c03c5f5e020fd05/bge-reranker-v2-m3-Q8_0.gguf
models:
  bonsai-chat:
    port: 9600
    lifecyclePort: 9608
    concurrencyLimit: 16
    name: Ternary Bonsai 2 27B PTQ1_0 DFlash2 Q8_0
    description: Experimental DFlash2 thinking/tool-use model; ternary Bonsai 2 27B on the PrismML llama.cpp fork with native tool calls, co-resident with the GPU search models
    cmd: '${server_bin}
      server
      bonsai
      --bin /app/bin/llama-server-bonsai
      --host 0.0.0.0
      --port ${PORT}
      --model ${bonsai_target}
      --model-draft ${bonsai_drafter}
      --gpu-layers-draft all
      --spec-type ${bonsai_spec_type}
      --spec-draft-n-max 7
      --alias bonsai-chat
      -ngl all
      --device CUDA0
      --fit off
      -c 262144
      --parallel 3
      --kv-unified
      --batch-size 2048
      --ubatch-size 512
      -fa on
      --cache-type-k q8_0
      --cache-type-v q8_0
      --temp 0.5
      --top-k 20
      --top-p 0.85
      --min-p 0.0
      --jinja
      --chat-template-file /chat_template/qwen3.8.jinja
      --reasoning-preserve
      --reasoning-budget 1024
      --reasoning-format deepseek
      --no-mmap
      --no-warmup
      --no-webui
      '
    cmdStop: /bin/kill -TERM ${PID}
  qwen3-embeddings:
    port: 9604
    lifecyclePort: 9610
    concurrencyLimit: 16
    name: Qwen3 Embeddings 0.6B FP16
    description: Dense embedding model for vector search, RAG, similarity
    cmd: '${server_bin}
      server
      bonsai
      --bin /app/bin/llama-server-bonsai
      --host 0.0.0.0
      --port ${PORT}
      --model ${embedding_model}
      --n-gpu-layers all
      --device CUDA0
      --fit off
      --threads 4
      --threads-batch 4
      --ctx-size 32768
      --batch-size 512
      --ubatch-size 512
      --parallel 4
      --kv-unified
      --flash-attn on
      --cache-type-k f16
      --cache-type-v f16
      --no-mmap
      --no-warmup
      --embedding
      --pooling last
      '
    cmdStop: /bin/kill -TERM ${PID}
  qwen3-reranker:
    port: 9606
    lifecyclePort: 9611
    concurrencyLimit: 16
    name: BGE Reranker v2 M3 Q8_0
    description: Compact GPU cross-encoder co-resident with the chat model and embeddings
    cmd: '${server_bin}
      server bonsai --bin /app/bin/llama-server-bonsai
      --host 0.0.0.0 --port ${PORT}
      --model ${reranker_model}
      --n-gpu-layers all --device CUDA0 --fit off --threads 2 --threads-batch 2
      --ctx-size 16384 --batch-size 8192 --ubatch-size 8192 --parallel 2
      --embedding --pooling rank --reranking --no-warmup --no-webui
      '
    cmdStop: /bin/kill -TERM ${PID}
