startPort: 9500
macros:
  pi_emb_hf_model: Qwen/Qwen3-Embedding-8B-GGUF:Q5_K_M
  dflash_pflash_profile: ''
  dflash_cache_args: ''
models:
  qwen3-chat:
    concurrencyLimit: 4
    name: Pi Qwen3 Chat
    description: Primary Luce dflash+pflash chat/messages model with SSE
    filters:
      setParams:
        reasoning: 'off'
        chat_template_kwargs:
          tokenize: false
          add_generation_prompt: true
          enable_thinking: false
          preserve_thinking: false
    cmd: '${server_bin}
      server
      lucebox
      --port ${PORT}
      --model-name qwen3-chat
      --target-hf unsloth/Qwen3.6-27B-GGUF:Q4_K_M
      --draft-hf KingsonHO/Qwen3.6-27B-DFlash:model.safetensors
      --budget 22
      --thinking-budget-extra 2048
      --max-ctx 131072
      ${dflash_cache_args}
      --fa-window 0
      --tokenizer Qwen/Qwen3.6-27B
      --prefill-compression auto
      --prefill-threshold 32000
      --prefill-keep-ratio 0.05
      --prefill-drafter-hf unsloth/Qwen3-0.6B-GGUF:Qwen3-0.6B-BF16.gguf
      --prefill-drafter-tokenizer Qwen/Qwen3-0.6B
      --pflash-use-bsa 1
      --pflash-alpha 0.85
      ${dflash_pflash_profile}
      '
  qwen3-embeddings:
    concurrencyLimit: 4
    name: Pi Qwen3 Embeddings 8B
    description: Dense embedding model for vector search, RAG, similarity
    cmd: '${server_bin}
      server
      llamacpp
      --bin /app/bin/llama-server-llamacpp
      --port ${PORT}
      -hf ${pi_emb_hf_model}
      --ctx-size 131072
      --batch-size 1024
      --ubatch-size 256
      --parallel 1
      --flash-attn on
      --cache-type-k f16
      --cache-type-v f16
      --kv-unified
      --no-mmap
      --embedding
      --no-warmup
      '
